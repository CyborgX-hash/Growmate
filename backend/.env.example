HUGGINGFACE_API_KEY=
GEMMA_API_URL=https://api-inference.huggingface.co/models/google/gemma-3-4b-it

VISION_MODEL_ID=kimcomehome/plantvillage-vit-leaf-disease
VISION_API_URL=https://api-inference.huggingface.co/models/kimcomehome/plantvillage-vit-leaf-disease
PYTHON_VISION_SERVICE_URL=

AI_TIMEOUT_MS=20000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
