PORT=5001
NODE_ENV=development
DATABASE_URL="file:./dev.db"
# DATABASE_URL="mysql://username:password@host:3306/growmate_db"
FRONTEND_URL=http://localhost:5173

# AI Inference Keys (Leave empty to trigger clearly labeled deterministic fallback boundaries)
